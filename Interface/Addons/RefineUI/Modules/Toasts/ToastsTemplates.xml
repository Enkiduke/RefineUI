<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <ContainedAlertFrame name="RefineUIToastAlertFrameTemplate" parent="UIParent" hidden="true" inherits="AlertFrameTemplate" virtual="true">
        <Size x="220" y="44"/>
        <Animations>
            <AnimationGroup parentKey="animIn">
                <Alpha fromAlpha="1" toAlpha="0" duration="0" order="1"/>
                <Alpha fromAlpha="0" toAlpha="1" duration="0.2" order="2"/>
            </AnimationGroup>
            <AnimationGroup parentKey="waitAndAnimOut">
                <Alpha startDelay="4" fromAlpha="1" toAlpha="0" duration="0.35" parentKey="animOut">
                    <Scripts>
                        <OnFinished>
                            self:GetRegionParent():Hide();
                        </OnFinished>
                    </Scripts>
                </Alpha>
            </AnimationGroup>
        </Animations>
    </ContainedAlertFrame>
</Ui>
